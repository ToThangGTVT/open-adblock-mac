// Shared build settings. Put your signing team in Config/Local.xcconfig (not committed):
//   DEVELOPMENT_TEAM = ABCDE12345
#include? "Local.xcconfig"

MARKETING_VERSION = 0.3.0
CURRENT_PROJECT_VERSION = 2
MACOSX_DEPLOYMENT_TARGET = 14.0
SDKROOT = macosx
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = minimal
CODE_SIGN_STYLE = Automatic
ENABLE_HARDENED_RUNTIME = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES

OAB_BUNDLE_PREFIX = io.github.tothanggtvt.openadblock.mac
// macOS App Groups must start with the team ID; Xcode fills TeamIdentifierPrefix when signing.
OAB_APP_GROUP = $(TeamIdentifierPrefix)$(OAB_BUNDLE_PREFIX)

// The tunnel ships as a system extension. Apple Development profiles allow the plain value;
// Developer ID distribution (Release) requires the -systemextension one.
OAB_NE_PROVIDER = packet-tunnel-provider
OAB_NE_PROVIDER[config=Release] = packet-tunnel-provider-systemextension
// Transparent proxy that hands browser connections to the core (browser filtering).
OAB_NE_PROXY = app-proxy-provider
OAB_NE_PROXY[config=Release] = app-proxy-provider-systemextension
